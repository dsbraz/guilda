                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "uncertainties": {
                    "description": "O que o agente n\u00e3o conseguiu confirmar.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
