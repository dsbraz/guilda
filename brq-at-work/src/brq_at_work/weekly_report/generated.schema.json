                },
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "name",
                "actor_kind"
            ],
            "title": "Actor",
            "type": "object"
        },
        "ActorKind": {
            "description": "",
            "enum": [
                "internal_person",
                "external_person",
                "agent"
            ],
            "title": "ActorKind",
            "type": "string"
        },
        "ReportCategory": {
            "description": "",
            "enum": [
                "progress",
                "delay_risk",
                "confirmed_delay",
                "renegotiated_deadline",
                "impediment",
                "decision",
                "change"
            ],
