# Configuração de deploy de uma instalação. Copie para .env e ajuste por cliente.
# Nada disso é fixo no código: o FDE escolhe provedor, modelos e regiões no deploy,
# conforme a residência que o cliente exige e o que o projeto Vertex oferece na região.
# O bootstrap grava a rota na instalação; um novo deploy a substitui.

# Projeto Vertex AI da instalação.
GUILDA_VERTEX_PROJECT=

# Modelo dos agentes (gemini ou claude), e a região em que é chamado.
GUILDA_MODEL_PROVIDER=
GUILDA_MODEL=
GUILDA_MODEL_REGION=

# Preço do modelo dos agentes por milhão de tokens de entrada e de saída, na moeda em
# que o custo de cada execução deve aparecer.
GUILDA_MODEL_INPUT_PRICE=
GUILDA_MODEL_OUTPUT_PRICE=

# Modelo com que a memória de contexto (Hindsight) extrai fatos, e sua região.
GUILDA_MEMORY_MODEL=
GUILDA_MEMORY_REGION=

# Embeddings da memória de contexto, e sua região.
GUILDA_EMBEDDING_MODEL=
GUILDA_EMBEDDING_REGION=

# --- Produção (deploy/compose.yaml lê este arquivo como deploy/.env) ---

# Domínio público do endpoint do bot; o Caddy obtém o certificado TLS para ele.
# O DNS precisa apontar para o IP externo da VM antes da primeira subida.
GUILDA_DOMAIN=

# Senhas do Postgres, uma por login. Use valores sem caracteres especiais, pois entram
# em URLs de conexão (por exemplo: openssl rand -hex 24). Só valem na primeira subida,
# quando o volume do banco é criado.
# Dono do banco guilda: migra e faz o bootstrap, nunca roda o serviço.
GUILDA_DB_OWNER_PASSWORD=
# Login da aplicação (membro de guilda_app, sob RLS).
GUILDA_DB_APP_PASSWORD=
# Login do publicador da outbox (membro de guilda_publisher).
GUILDA_DB_PUBLISHER_PASSWORD=
# Logins do Temporal e da memória de contexto, donos dos seus bancos.
TEMPORAL_DB_PASSWORD=
HINDSIGHT_DB_PASSWORD=

# Fila do Temporal em que o worker da instalação escuta.
GUILDA_TASK_QUEUE=

# Banco de memórias da instalação no Hindsight.
GUILDA_HINDSIGHT_BANK=

# --- Adaptadores (todos obrigatórios em produção) ---
# Sem alguma variável obrigatória, o app não sobe e o log nomeia a que falta. Cada app do
# Entra usa um segredo ou um certificado, nunca os dois. Um PEM vai entre aspas duplas,
# com as quebras de linha como estão no arquivo.

# SharePoint: a biblioteca de documentos da base corporativa, lida por um app do Entra
# com Sites.Selected (leitura) no site da biblioteca.
GUILDA_SHAREPOINT_TENANT=
GUILDA_SHAREPOINT_CLIENT_ID=
GUILDA_SHAREPOINT_CLIENT_SECRET=
# Ou, no lugar do segredo, a chave privada RSA (PEM, sem senha) e o certificado (PEM)
# registrado no app.
GUILDA_SHAREPOINT_CERTIFICATE_KEY=
GUILDA_SHAREPOINT_CERTIFICATE=
# Ou, só para desenvolvimento, ler como um usuário, sem admin do tenant: só o que ele vê.
# O app do Entra precisa de "Allow public client flows" (Authentication) e das permissões
# delegadas Files.Read.All e offline_access; o próprio usuário consente no login, se o
# tenant permitir consentimento do usuário. Entre uma vez com
#   uv run python -m guilda_sharepoint.login --tenant <tenant> --client-id <app> \
#     --token-path <arquivo> [--link <link da pasta>]
# e aponte aqui o arquivo (0600). Com --link (o link que o SharePoint copia em
# "Copiar link" na pasta), o login imprime os valores de GUILDA_SHAREPOINT_DRIVE_ID e
# GUILDA_SHAREPOINT_FOLDER_ID; se não resolver o link, avisa, sai com erro e mantém o login. O refresh token gira a cada uso e é regravado no mesmo
# arquivo: no compose, monte-o num volume gravável. Se o login expirar, a base fica
# indisponível e pede para rodar o login de novo. Segredo, certificado e token: só um.
GUILDA_SHAREPOINT_TOKEN_PATH=
# O drive da biblioteca e, opcionalmente, a pasta a que a leitura se restringe.
GUILDA_SHAREPOINT_DRIVE_ID=
GUILDA_SHAREPOINT_FOLDER_ID=

# Granola: chave de API do workspace e, opcionalmente, o espaço ou a pasta a ler.
GUILDA_GRANOLA_API_KEY=
GUILDA_GRANOLA_SPACE_ID=
GUILDA_GRANOLA_FOLDER_ID=

# Teams: o Azure Bot (single tenant), o Bot Connector da região do tenant (por exemplo
# https://smba.trafficmanager.net/teams/) e o segredo do bot.
GUILDA_TEAMS_APP_ID=
GUILDA_TEAMS_TENANT_ID=
GUILDA_TEAMS_SERVICE_URL=
GUILDA_TEAMS_SECRET=
# Ou, no lugar do segredo, a chave privada (PEM) e o thumbprint SHA-1 que o Entra mostra
# para o certificado enviado.
GUILDA_TEAMS_CERTIFICATE_KEY=
GUILDA_TEAMS_CERTIFICATE_THUMBPRINT=
# A conversa do Teams da thread do projeto: o id de um canal ou de uma cadeia de
# respostas. É ligada à thread do arquivo do agente (thread em project_assistant.yaml).
GUILDA_TEAMS_CONVERSATION=

# --- Telegram (só para desenvolvimento local) ---
# GUILDA_CHANNEL=telegram troca o Teams pelo Telegram, sem endpoint público, túnel nem
# Azure Bot: o serviço lê o bot por long polling, e as variáveis do Teams deixam de ser
# exigidas. Mensagens de bot no Telegram não têm criptografia ponta a ponta: não use com
# dados de cliente. O bot vem do BotFather, com o privacy mode desativado (/setprivacy)
# para ler o grupo. Cada pessoa é ligada ao seu id de usuário do Telegram numa cópia
# local das identidades (GUILDA_IDENTITIES_PATH, channel_ids: [telegram:<id>]) e manda
# /start ao bot, para receber os cards no privado.
# GUILDA_CHANNEL=telegram
# GUILDA_TELEGRAM_BOT_TOKEN=
# O grupo da thread do projeto (id negativo, por exemplo -1001234567890) e, se o grupo
# tiver tópicos, o tópico. É ligado à thread do arquivo do agente.
# GUILDA_TELEGRAM_CHAT_ID=
# GUILDA_TELEGRAM_TOPIC_ID=
# Arquivo em que o canal guarda a mensagem de cada card do Telegram.
# GUILDA_TELEGRAM_CARDS_PATH=/tmp/guilda-telegram-cards

# --- Identidades ---
# As pessoas e seus ids nos canais vêm de brq-at-work/src/brq_at_work/identities.yaml.
# Para ids reais de desenvolvimento, aponte uma cópia fora do repositório (o override
# local monta .secrets/identities.yaml), sem tocar no arquivo versionado.
# GUILDA_IDENTITIES_PATH=

# O compose monta, a partir das senhas acima, o que python -m brq_at_work.serve lê;
# fora dele, defina-as à mão:
# GUILDA_OWNER_DATABASE_URL=postgresql://guilda:SENHA@HOST:5432/guilda
# GUILDA_DATABASE_URL=postgresql://guilda_app_login:SENHA@HOST:5432/guilda
# GUILDA_PUBLISHER_DATABASE_URL=postgresql://guilda_publisher_login:SENHA@HOST:5432/guilda
# GUILDA_TEMPORAL_ADDRESS=HOST:7233
# GUILDA_HINDSIGHT_URL=http://HOST:8888
# GUILDA_HTTP_PORT=8000
# Arquivo em que o canal guarda a mensagem de cada card do Teams; num volume persistente.
# GUILDA_TEAMS_CARDS_PATH=/var/lib/guilda/teams-cards
